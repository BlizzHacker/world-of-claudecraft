# FPS Realm — first-person-only world process, served at fps.moveweight.com.
# Layered on top of /opt/cryptic-realm/.env by the systemd template.
REALM_NAME=FPS
REALM_TYPE=Normal
PORT=8797
# First-person-only realm. The fpsOnly flag in the realm content locks the
# client camera; this env var lets the server advertise the constraint.
CR_FPS_ONLY=1
# Directory served to clients on the realm-list endpoint. Each entry is
# Name=publicURL=Type so the client knows where to connect for each realm.
REALMS=Cryptic Realm=https://crypticrealm.com=Normal,Infernal=https://infernal.crypticrealm.com=Normal,Classic=https://classic.crypticrealm.com=Normal,Dominion=https://dominion.crypticrealm.com=PvP,Arcane=https://arcane.crypticrealm.com=Normal,ClaudeCraft=https://claudecraft.crypticrealm.com=Normal,FPS=https://fps.moveweight.com=Normal,Exchange=https://exchange.crypticrealm.com=RP,Alpha=https://alpha.crypticrealm.com=Normal,Beta=https://beta.crypticrealm.com=Normal
