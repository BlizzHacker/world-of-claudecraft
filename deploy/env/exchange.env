# The Exchange — the cross-realm marketplace. Characters from every other
# realm can visit here. Combat / questing are intentionally disabled by the
# server when CR_CROSS_REALM=1 is set; auctions + 1v1 trade still work.
REALM_NAME=Exchange
REALM_TYPE=RP
PORT=8792
WEB_ORIGINS=https://crypticrealm.com,https://fps.moveweight.com
# Flagging the process as a cross-realm hub. Picked up by server runtime
# (server/realm.ts → IS_CROSS_REALM) to disable PvE / quest credit and
# enable cross-realm character admission.
CR_CROSS_REALM=1
REALMS=Infernal=https://infernal.crypticrealm.com=Normal,Classic=https://classic.crypticrealm.com=Normal,Dominion=https://dominion.crypticrealm.com=PvP,Arcane=https://arcane.crypticrealm.com=Normal,ClaudeCraft=https://claudecraft.crypticrealm.com=Normal,Exchange=https://exchange.crypticrealm.com=RP,Alpha=https://alpha.crypticrealm.com=Normal,Beta=https://beta.crypticrealm.com=Normal
