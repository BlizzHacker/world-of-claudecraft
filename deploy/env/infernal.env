# Cryptic Realm — Infernal world process
# Layered on top of /opt/cryptic-realm/.env by the systemd template.
REALM_NAME=Infernal
REALM_TYPE=Normal
PORT=8788
# Directory served to clients on the realm-list endpoint. Each entry is
# Name=publicURL=Type so the client knows where to connect for each realm.
REALMS=Infernal=https://infernal.crypticrealm.com=Normal,Classic=https://classic.crypticrealm.com=Normal,Dominion=https://dominion.crypticrealm.com=Normal,Arcane=https://arcane.crypticrealm.com=Normal,ClaudeCraft=https://claudecraft.crypticrealm.com=Normal,Exchange=https://exchange.crypticrealm.com=RP
