# Pristine upstream identity — claudemoon realm name + base port preserved
# so existing characters keep working when the multi-realm deploy lands.
REALM_NAME=Claudemoon
REALM_TYPE=Normal
PORT=8793
WEB_ORIGINS=https://crypticrealm.com,https://fps.moveweight.com
REALMS=Infernal=https://infernal.crypticrealm.com=Normal,Classic=https://classic.crypticrealm.com=Normal,Dominion=https://dominion.crypticrealm.com=PvP,Arcane=https://arcane.crypticrealm.com=Normal,ClaudeCraft=https://claudecraft.crypticrealm.com=Normal,Exchange=https://exchange.crypticrealm.com=RP,Alpha=https://alpha.crypticrealm.com=Normal,Beta=https://beta.crypticrealm.com=Normal
GITHUB_REPO=levy-street/world-of-claudecraft
CR_UPSTREAM_BRANDING=1

# Claudcraft intentionally does not inherit Cryptic Realm's CR SPL token.
# Blank overrides win over the shared /opt/cryptic-realm/.env values.
CR_SOLANA_RPC=
CR_SOLANA_NETWORK=solana
CR_SOLANA_MINT=
CR_SOLANA_DECIMALS=9
CR_SPL_TOKEN_CLI=
CR_SOLANA_MINT_AUTHORITY=
