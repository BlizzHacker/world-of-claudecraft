## Promotion unit (templated by ring): cryptic-realm-promote@{alpha,beta,live}.
## Runs scripts/admin/promote-all.sh <ring> to advance that ring across all
## staged realms (ff downstream branch to upstream commit + redeploy the stage).
##
## Install:
##   cp deploy/systemd/cryptic-realm-promote@.service /etc/systemd/system/
##   cp deploy/systemd/cryptic-realm-promote-*.timer  /etc/systemd/system/
##   systemctl daemon-reload
##   systemctl enable --now cryptic-realm-promote-alpha.timer \
##                          cryptic-realm-promote-beta.timer \
##                          cryptic-realm-promote-live.timer

[Unit]
Description=Cryptic Realm — promote %i ring across all realms
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/cryptic-realm
Environment=CR_TOOLING=/opt/cryptic-realm
Environment=CR_LOG_FILE=/var/log/cryptic-realm-stage.log
ExecStart=/usr/bin/env bash /opt/cryptic-realm/scripts/admin/promote-all.sh %i
StandardOutput=journal
StandardError=journal
TimeoutStartSec=3600
