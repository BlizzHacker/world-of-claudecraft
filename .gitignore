# dependencies
node_modules

# agent-local git worktrees
.worktrees/

# build outputs
dist/
dist-env/
dist-ota/
dist-server/
# facebook:build zip output (scripts/build_facebook_bundle.mjs)
dist-facebook/
release/
release-steam/
# generated main-process runtime bundles (scripts/electron-vendor.mjs)
electron/vendor/
media-cache/
sfx-runtime/

# i18n per-locale emit crash leftovers (the build sweeps these; never commit one)
src/ui/i18n.resolved.generated/*.tmp
src/admin/i18n.resolved.generated/*.tmp

# i18n status registry + its counts summary: build/test-only (the registry is ~4.7 MB),
# regenerated by `pretest` and the CI `npm run i18n:gen` step before any test reads it;
# never shipped, never reviewed. Both the full registry and the counts summary are
# generated and gitignored; the audit trail is posted out-of-band to the CI job summary
# by the coverage-summary step.
src/ui/i18n.status.json
src/ui/i18n.status.summary.json

# retired aggregate i18n sha256 baseline (superseded by the per-locale emit split);
# must stay untracked, see tests/i18n_resolved_equivalence.test.ts
src/ui/i18n.resolved.sha256

# private extensions (e.g. bot-detector)
private/*
!private/.dockerkeep

# test artifacts & screenshots
tmp/
# tests/sfx_studio_server_security.test.ts drops a per-pid symlink probe here
# (public/models/sfx-studio-security-<pid>.glb) and removes it in afterAll, but a
# killed run can strand one. Never commit these: a stranded symlink points at the
# runner's absolute path, so it is broken everywhere else and fails vite build's
# public/ copy (the whole client build dies in prepare-out-dir).
public/models/sfx-studio-security-*.glb
# PR-assist screenshot tour output + its CI-only ephemerals
pr-shots*/
pr.diff
.devpid
.codex-research/
# Codex local state stays ignored; shared project configuration and agents are tracked.
.codex/*
!.codex/config.toml
!.codex/hooks.json
!.codex/agents/
!.codex/agents/*.toml
!.codex/hooks/
!.codex/hooks/*.sh
.playwright-mcp/
# Local Chrome-for-testing download used by browser E2E sessions (never repo source)
.chrome/
# Vitest Browser Mode failure screenshots + attachments (opt-in test:browser suite)
tests/browser/__screenshots__/
.vitest-attachments/
# Mobile safe-area E2E before/after PNG output (scripts/mobile_*_safe_area.mjs,
# root-anchored: a bare screenshots/ would swallow new files under docs/screenshots/)
/screenshots/

# i18n release-fill worklist (generated; regenerate via `npm run i18n:worklist`)
docs/i18n-scaling/worklist/

# python
__pycache__/
*.pyc
.venv/

# environment / secrets
.env
.env.*
!.env.example
cr-solana.env
# Solana devnet/prod authority keypairs — never commit
secrets/
# Local deploy staging artifacts produced by scripts/admin/*
deploy-staging/
AuthKey_*.p8
# Per-host realm environment files are provisioned/generated by deploy scripts.
# Keep credentials and stage-specific overrides out of the repository worktree.
env.d/*.env
env.d/*.env.*
env.d/*.bak*
.maintenance
# Meshy asset-gen tooling embeds an API key, never commit it
scripts/generate_treasure_chest.mjs

# editor & OS noise
.DS_Store
Thumbs.db
*.log
.idea/
# .claude/: keep personal/local config out of git, but track the shared team tooling
# (agents, skills, commands, hooks, and the project hooks config). settings.local.json,
# which is personal/local, stays ignored by the .claude/* rule above.
.claude/*
!.claude/skills/
!.claude/agents/
# CR overlay: lxc rescue artifacts + generated realm assets
.lxc-recovery-20260616/
index.html.lxc-overlay
# CR overlay: raw asset intake is audited/processed locally, then exported into
# public/cr-realms or an external asset store. Do not commit these as Git blobs.
classic realm assets/
claudcraft realm assets/
claudcraft realm assets.zip
cryptic realm assets/
infernal realm assets/
# CR overlay: generated realm assets (run npm run assets:realms to regenerate)
public/cr-realms/
# CR overlay: optimized landmark GLBs (npm run assets:infernal-waypoint); prod
# serves /forged/* from the shared forged store, dev regenerates locally.
public/forged/
# CR overlay: dev-only junction into the PICKTURA share for the rig QA viewer.
public/picktura-qa/
# Classic engine asset manifest — 20MB generated JSON, fetched at runtime.
# Must be synced to the server out-of-band (deploy / asset-hosting step).
public/classic/asset-manifest.json
# Classic engine runtime assets — large binary dirs copied from moveweight-ui.
# Must be synced to the server out-of-band (deploy / asset-hosting step).
public/classic/cryptic-assets/

# App packaging — track the native PROJECT source so builds are reproducible,
# but ignore build artifacts + secrets. (Capacitor's own android/.gitignore and
# ios/.gitignore already exclude build/, Pods/, DerivedData, generated configs.)
/android/app/build
/android/build
/android/.gradle
/android/local.properties
/android/keystore.properties
/android/**/*.keystore
/android/**/*.jks
/src-tauri/target
# Steam staged content (rebuilt by build-steam.sh)
/steam/content
/steam/output
/src-tauri/gen


# Android signing secrets
*.keystore
android/keystore.properties
android/local.properties

