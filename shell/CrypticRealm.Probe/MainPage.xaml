<Page
    x:Class="CrypticRealm.Probe.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#0B1020">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock x:Name="Title"
                       Foreground="#E8C87A"
                       FontSize="64"
                       TextAlignment="Center"
                       Text="UWP OK" />
            <TextBlock x:Name="Detail"
                       Foreground="#9FB3D9"
                       FontSize="26"
                       Margin="0,24,0,0"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Text="If you can read this, sideloaded UWP works on this console and the fault is WebView2." />
            <TextBlock x:Name="Pad"
                       Foreground="#7FE3A1"
                       FontSize="30"
                       Margin="0,32,0,0"
                       TextAlignment="Center"
                       Text="controller: waiting" />
        </StackPanel>
    </Grid>
</Page>
